# Environment files; keep only the checked, empty example template
.env
.env.*
!.env.example

# Python and test-generated files
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Production and other YAML configuration; explicitly allow the checked sample
*.yaml
*.yml
!config/config.example.yaml

# Credentials, key material, and certificates
secrets/
**/secrets/**
.secret/
*.secret
*.secrets
*.token
*.credentials
*.credentials.*
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
id_rsa*
id_ed25519*
.local-client-key

# Logs, evidence, databases, backups, and runtime state
evidence/
**/evidence/**
logs/
**/logs/**
*.log
*.sqlite*
*.db
*.db-*
*.sql
*.dump
*.bak
*.backup*
*.tar
*.tar.gz
*.tgz
*.zip
data/
backups/
backup/
volumes/
instance/
state/
runtime/
var/

# Generate a private local pepper with scripts/init_env.sh; never commit a real .env.
GATEWAY_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Add provider keys only after configuring a verified provider endpoint and model ID.
# OPENAI_API_KEY=
# PROVIDER_API_KEY=

# Admin console. TRUSTED_PROXIES stays empty unless a reverse proxy you control sits in front of the gateway.
# Forwarded headers are read only when the direct peer is listed here.
# TRUSTED_PROXIES=10.0.0.5
# Required when a proxy changes the scheme or host the browser sees, for example https://admin.example.invalid
# ADMIN_ALLOWED_ORIGINS=
# ADMIN_SESSION_TTL_SECONDS=28800
# ADMIN_SESSION_IDLE_SECONDS=1800
# ADMIN_LOGIN_MAX_FAILURES=5
# ADMIN_LOGIN_WINDOW_SECONDS=900

# Provider key encryption. Keep the master key in a protected file outside the repository
# (owned by uid 10001, mode 0400 or 0440) and point GATEWAY_MASTER_KEY_FILE at it.
# Generate 32 random bytes with: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# GATEWAY_MASTER_KEY_FILE=/run/secrets/gateway_master_key
# GATEWAY_MASTER_KEY_VERSION=1
# Set these only while rotating keys, then remove them after: python -m app.admin provider-secret rotate
# GATEWAY_MASTER_KEY_PREVIOUS_FILE=/run/secrets/gateway_master_key_previous
# GATEWAY_MASTER_KEY_PREVIOUS_VERSION=0

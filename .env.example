# ==============================================================================
# LOCAL DEVELOPMENT ONLY (.env)
# ==============================================================================
# CAUTION: In PRODUCTION, secrets MUST NEVER be placed in .env or Config.Env.
# Production deployments MUST use file-based secrets mounted at /secrets:
#   - GATEWAY_PEPPER_FILE=/secrets/pepper (mode 0400, owned by 10001:10001)
#   - OPENROUTER_API_KEY_FILE=/secrets/openrouter_key (mode 0400, owned by 10001:10001)
#
# Generate a local development pepper with: ./scripts/init_env.sh
GATEWAY_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_FOR_LOCAL_DEV_ONLY

# Add local provider test keys only after configuring a verified provider endpoint:
# OPENROUTER_API_KEY=
